<!-- Tabletop scene: Franka Panda mounted at the world origin on a table.
     World frame: origin = robot base on the table surface, +x = forward, +z = up.
     Table top is at z=0, floor at z=-0.75. -->
<mujoco model="tabletop">
  <include file="franka_emika_panda/panda.xml"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top" rgba="0.55 0.42 0.3 1"/>
    <material name="table_leg" rgba="0.3 0.3 0.3 1"/>
  </asset>

  <worldbody>
    <light pos="0.4 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.75" material="floor"/>

    <!-- Table: 1.3 x 1.2 m top spanning x in [-0.3, 1.0], y in [-0.6, 0.6] -->
    <body name="table" pos="0.35 0 0">
      <geom name="table_top" type="box" size="0.65 0.6 0.025" pos="0 0 -0.025" material="table_top"/>
      <geom type="box" size="0.03 0.03 0.35" pos=" 0.6  0.55 -0.4" material="table_leg"/>
      <geom type="box" size="0.03 0.03 0.35" pos=" 0.6 -0.55 -0.4" material="table_leg"/>
      <geom type="box" size="0.03 0.03 0.35" pos="-0.6  0.55 -0.4" material="table_leg"/>
      <geom type="box" size="0.03 0.03 0.35" pos="-0.6 -0.55 -0.4" material="table_leg"/>
    </body>

    <!-- Objects: 4 cm cubes resting on the table -->
    <body name="cube_red" pos="0.55 -0.15 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.85 0.2 0.2 1" mass="0.05"/>
    </body>
    <body name="cube_green" pos="0.6 0.0 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.2 0.75 0.3 1" mass="0.05"/>
    </body>
    <body name="cube_blue" pos="0.55 0.15 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.2 0.4 0.85 1" mass="0.05"/>
    </body>

    <!-- IK target marker (mocap, visual only) -->
    <body name="target" mocap="true" pos="0.5 0 0.3">
      <geom type="box" size="0.015 0.015 0.015" contype="0" conaffinity="0" rgba="1 0.6 0 0.35"/>
    </body>
  </worldbody>
</mujoco>
